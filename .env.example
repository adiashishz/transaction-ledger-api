# Django
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL. `docker compose up` creates this database and user from these values.
# With your own PostgreSQL, create them before running `migrate` (see README, step 3).
DB_NAME=ledger
DB_USER=ledger
DB_PASSWORD=ledger
DB_HOST=localhost
DB_PORT=5432
